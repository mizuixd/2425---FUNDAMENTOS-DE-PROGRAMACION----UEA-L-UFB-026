import numpy as np

# Crear una matriz 3D de temperaturas diarias en varias ciudades, días de la semana y semanas
# Supongamos que tenemos 3 ciudades, 7 días de la semana y 4 semanas
ciudades = 3
dias_semana = 7
semanas = 4

# Generamos datos aleatorios de temperaturas entre 15 y 30 grados
temperaturas = np.random.randint(15, 31, size=(ciudades, dias_semana, semanas))

# Calcular el promedio de temperaturas por ciudad y semana
promedios = np.zeros((ciudades, semanas))

# Usamos bucles anidados para calcular los promedios
for ciudad in range(ciudades):
    for semana in range(semanas):
        promedios[ciudad, semana] = np.mean(temperaturas[ciudad, :, semana])

# Mostrar el promedio de temperaturas para cada ciudad y semana
print(promedios)
